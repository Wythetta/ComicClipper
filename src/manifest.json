{
  "manifest_version": 2,
  "name": "ComicClipper",
  "version": "0.3.2",
  "description": "批次下載漫畫網站的整冊圖片，每冊轉成一個 PDF，用 Send to Kindle 傳到 Kindle Scribe 閱讀。",
  "browser_specific_settings": {
    "gecko": {
      "id": "comic-clipper@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "ComicClipper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/comic16.png",
      "48": "icons/comic48.png",
      "128": "icons/comic128.png"
    }
  },
  "background": {
    "scripts": [
      "lib/util.js",
      "lib/pdf-writer.js",
      "lib/image-pipeline.js",
      "lib/lz-string.js",
      "lib/unpacker.js",
      "sites/registry.js",
      "sites/acgn.js",
      "sites/manhuagui.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/comic16.png",
    "48": "icons/comic48.png",
    "128": "icons/comic128.png"
  }
}
